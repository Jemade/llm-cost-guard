# LLM Cost Guard - Environment Configuration

APP_NAME="LLM Cost Guard"
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO

# Database Connection String
# PostgreSQL (Production & Docker):
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/costguard
# SQLite (Local Lightweight Dev):
# DATABASE_URL=sqlite+aiosqlite:///costguard.db

# Pricing Configuration Path
PRICING_FILE_PATH=config/pricing.yaml

# Budget Limits (USD)
DEFAULT_DAILY_BUDGET=10.0
DEFAULT_WEEKLY_BUDGET=50.0
DEFAULT_MONTHLY_BUDGET=200.0

# Concurrency & Reservations
RESERVATION_TTL_SECONDS=60

# External Alert Notification Webhook (Slack, Discord, or generic endpoint)
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/T000/B000/XXXXX
